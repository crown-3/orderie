# Input mode: "auto" uses server VAD, "ptt" requires holding a key to speak
NEXT_PUBLIC_INPUT_MODE=ptt

# Keybindings (single characters; defaults shown)
NEXT_PUBLIC_KEY_COMMIT=a
NEXT_PUBLIC_KEY_SLEEP=k
NEXT_PUBLIC_KEY_WAKE=l
NEXT_PUBLIC_KEY_WINK=j
NEXT_PUBLIC_KEY_CENTER=c
NEXT_PUBLIC_KEY_PT_PREV=d
NEXT_PUBLIC_KEY_PT_NEXT=f
NEXT_PUBLIC_KEY_PT_CLOSE=x

# Show keybinding debug toasts: "true" enables, anything else disables
NEXT_PUBLIC_DEBUG=false

# Disable user-side STT transcription display: "true" suppresses it
NEXT_PUBLIC_DISABLE_USER_TRANSCRIPT=true